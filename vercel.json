{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/generate-apprentices.ts": {
      "maxDuration": 60,
      "includeFiles": "public/templates/Apprentices_Act_1961/**"
    },
    "api/generate-clra.ts": {
      "maxDuration": 60,
      "includeFiles": "public/templates/CLRA_Act_1970/**"
    },
    "api/generate-code-wages.ts": {
      "maxDuration": 60,
      "includeFiles": "public/templates/Code_on_Wages/**"
    },
    "api/generate-factories.ts": {
      "maxDuration": 60,
      "includeFiles": "public/templates/Factories_Act_1948/**"
    },
    "api/generate-se-act.ts": {
      "maxDuration": 60,
      "includeFiles": "public/templates/SE_Act/**"
    },
    "api/download.ts": {
      "maxDuration": 30
    },
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/email-handler.ts": {
      "maxDuration": 60
    },
    "api/populate-master.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/generate-apprentices",
      "destination": "/api/generate-apprentices"
    },
    {
      "source": "/api/generate-clra",
      "destination": "/api/generate-clra"
    },
    {
      "source": "/api/generate-code-wages",
      "destination": "/api/generate-code-wages"
    },
    {
      "source": "/api/generate-factories",
      "destination": "/api/generate-factories"
    },
    {
      "source": "/api/generate-se-act",
      "destination": "/api/generate-se-act"
    },
    {
      "source": "/api/generate-se-act/states",
      "destination": "/api/generate-se-act"
    },
    {
      "source": "/api/populate-master",
      "destination": "/api/populate-master"
    },
    {
      "source": "/api/download-bocw",
      "destination": "/api/download?doc=bocw"
    },
    {
      "source": "/api/download-equal-remuneration",
      "destination": "/api/download?doc=equal-remuneration"
    },
    {
      "source": "/api/download-ismw",
      "destination": "/api/download?doc=ismw"
    },
    {
      "source": "/api/download-maternity-benefit",
      "destination": "/api/download?doc=maternity-benefit"
    },
    {
      "source": "/api/download-posh",
      "destination": "/api/download?doc=posh"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/email/approval",
      "destination": "/api/email-handler?action=approval"
    },
    {
      "source": "/api/email/rejection",
      "destination": "/api/email-handler?action=rejection"
    },
    {
      "source": "/api/email/kyc-request",
      "destination": "/api/email-handler?action=kyc-request"
    },
    {
      "source": "/api/email/kyc-verified",
      "destination": "/api/email-handler?action=kyc-verified"
    },
    {
      "source": "/api/webhooks/signup",
      "destination": "/api/email-handler?action=signup"
    },
    {
      "source": "/api/kyc/info",
      "destination": "/api/email-handler?action=kyc-info"
    },
    {
      "source": "/api/kyc/file",
      "destination": "/api/email-handler?action=kyc-file"
    },
    {
      "source": "/api/kyc/submit",
      "destination": "/api/email-handler?action=kyc-submit"
    },
    {
      "source": "/api/validation/zoho-upload",
      "destination": "/api/email-handler?action=val-upload"
    },
    {
      "source": "/api/validation/l2-submit",
      "destination": "/api/email-handler?action=val-submit"
    },
    {
      "source": "/api/validation/l3-status",
      "destination": "/api/email-handler?action=val-status"
    },
    {
      "source": "/api/validation/certificate",
      "destination": "/api/email-handler?action=val-cert"
    },
    {
      "source": "/api/auditor/portal/bootstrap",
      "destination": "/api/email-handler?action=aud-bootstrap"
    },
    {
      "source": "/api/auditor/reviews/claim",
      "destination": "/api/email-handler?action=aud-claim"
    },
    {
      "source": "/api/auditor/file",
      "destination": "/api/email-handler?action=aud-file"
    },
    {
      "source": "/api/auditor/reviews/decision",
      "destination": "/api/email-handler?action=aud-decision"
    },
    {
      "source": "/api/auditor/certificate",
      "destination": "/api/email-handler?action=aud-cert"
    },
    {
      "source": "/api/certificate/verify",
      "destination": "/api/email-handler?action=cert-verify"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}